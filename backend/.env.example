DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/noticeboard
# At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=60
# Failed logins allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Comma-separated list of frontend addresses allowed to call the API
CORS_ORIGINS=http://localhost:5173
